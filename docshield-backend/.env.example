# ==============================================================================
# DocShield AI Backend — Environment Configuration Template (.env.example)
# DO NOT put real secrets in this file. Copy to .env for local development.
# ==============================================================================

# Application Environment: 'development', 'production', or 'testing'
FLASK_ENV=development

# Core Security Keys (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-string-in-production-min-32-chars
JWT_SECRET_KEY=change-this-to-another-secure-random-jwt-key-min-32-chars

# AES-256-GCM Encryption Key (Must be exactly 256 bits / 64 hex characters)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DOCSHIELD_AES_KEY=

# Privacy & Upload Lifecycle (default false: deletes encrypted uploads immediately after analysis)
RETAIN_UPLOADS_FOR_DEMO=false

# JWT Lifetime Settings
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Database Connection URI (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///instance/docshield.db

# CORS Allowed Origins (Comma-separated list, NO wildcard '*' in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Security Settings
MAX_CONTENT_LENGTH_MB=10
UPLOAD_FOLDER=uploads
MAX_IMAGE_DIMENSION=8000

# Rate Limiting Policies (Flask-Limiter)
RATELIMIT_DEFAULT=100/hour
RATELIMIT_ANALYZE=20/minute
RATELIMIT_LOGIN=5/15minute
RATELIMIT_STORAGE_URI=memory://

# Admin Initial Seed Credentials (used for initial database seeding only)
ADMIN_INITIAL_EMAIL=admin@docshield.local
ADMIN_INITIAL_PASSWORD=DocShieldAdmin@2026!

# ML & OCR Optional Custom Paths
TESSERACT_CMD=
MODEL_WEIGHTS_PATH=app/ml/weights/efficientnet_b0_docshield.pth
